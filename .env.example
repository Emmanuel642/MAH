# Configuration Resend (https://resend.com/api-keys)
# Clé API secrète Resend (côté serveur uniquement — ne jamais exposer côté client)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Adresse email de destination qui recevra les demandes de contact de MHA
MHA_CONTACT_EMAIL=contact@mha-rdc.com

# Adresse email d'expédition autorisée par Resend
# - En phase de test (sans domaine personnalisé vérifié) : Modern Home Architecture <onboarding@resend.dev>
# - En production avec domaine validé (ex: mha-rdc.com) : Modern Home Architecture <contact@mha-rdc.com>
MHA_FROM_EMAIL=Modern Home Architecture <onboarding@resend.dev>
